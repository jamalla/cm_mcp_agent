# Every value is optional; the demo runs offline with none of them set.

# The engine's MCP endpoint -- the only coupling to cm_mcp_engine.
CM_MCP_URL=http://127.0.0.1:8765/mcp

# When set, routing uses an OpenAI model. Without it the deterministic offline
# router runs and the UI looks identical.
OPENAI_API_KEY=

# Optional: which model routes. Defaults inside cm_agent/graph.py.
# CM_ROUTER_MODEL=gpt-5.1

# Sibling cm_mcp_engine checkout, used only by scripts/dev.ps1 to start the
# engine for a one-command demo. Unset it to run agent-only.
CM_ENGINE_DIR=../cm_mcp_engine

BFF_HOST=127.0.0.1
BFF_PORT=8000
